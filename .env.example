# --- OCI API credentials ---------------------------------------------------
# Oracle console -> Profile icon (top right) -> My profile -> API keys
# -> Add API Key -> "Generate API Key Pair", download the private key.
# Copy user OCID / tenancy OCID / fingerprint from the "Config file preview".
OCI_CLI_USER=ocid1.user.oc1..xxxx
OCI_CLI_TENANCY=ocid1.tenancy.oc1..xxxx
OCI_CLI_FINGERPRINT=aa:bb:cc:...

# Either paste the private key (escape newlines as \n, keep the quotes):
# OCI_CLI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# ...or point at a file next to these scripts:
# OCI_CLI_KEY_FILE=oci_api_key.pem

# Must be your tenancy's HOME region (A1 instances can only be created there).
OCI_CLI_REGION=eu-amsterdam-1

# --- Telegram ---------------------------------------------------------------
TG_BOT_ID=123456789:AA...
# Chat to send notifications to (message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat"."id")
TG_CHAT_ID=123456789

# --- Optional (defaults shown) ----------------------------------------------
#OCPU=2
#MEM_GB=12
#BOOT_GB=100
#CHECK_EVERY_SEC=65
#HEARTBEAT_EVERY=10
#AVAILABILITY_DOMAIN=
#SHAPE=VM.Standard.A1.Flex
#SSH_PUBKEY=
